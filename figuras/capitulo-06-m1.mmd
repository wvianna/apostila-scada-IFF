        D1[Sensor IIoT]
        D2[Atuador Inteligente]
        GW[Gateway / Edge Controller]
    end
    subgraph "Borda Intermediária (Fog)"
        FOG[Servidor Fog / MEC]
    end
    subgraph "Nuvem (Cloud)"
        CLOUD[Plataforma Cloud\nAWS / Azure / Google]
